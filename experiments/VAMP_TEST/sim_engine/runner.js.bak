const fs = require('fs');
const path = require('path');
const configLoader = require('./utils/config_loader');
const envManager = require('./utils/environment');
const apiClient = require('./utils/api_client');
const stateManager = require('./utils/state_manager');
const logger = require('./utils/logger');
const validator = require('./utils/validator');
const { TAGS, SYNTAX, DEFAULTS } = require('./utils/constants');

// Pfade
const skillDir = path.join(__dirname, '..');
const projectRoot = path.join(skillDir, '../../..');
const experimentsDir = path.join(projectRoot, 'experiments');

const version = process.argv[2];
if (!version) { console.error("Fehler: Versions-Flag fehlt."); process.exit(1); }

const vDir = path.join(experimentsDir, version);
const vConfigPath = path.join(vDir, 'config.json');
const coreConfigPath = path.join(skillDir, 'core-config.json');

// 1. Boot-Validierung & Initialisierung
validator.validateEnvironment(projectRoot);

if (!fs.existsSync(vDir)) {
    console.log(`Initialisiere neue Version: ${version}...`);
    fs.mkdirSync(vDir, { recursive: true });
    const boilerplate = {
        agents: [{ id: "Alpha", system_prompt: ".", initial_trigger: "..." }],
        rounds: 15, distillation_interval: DEFAULTS.DISTILLATION_INTERVAL
    };
    fs.writeFileSync(vConfigPath, JSON.stringify(boilerplate, null, 2));
    process.exit(0);
}

const config = configLoader.loadConfig(coreConfigPath, vConfigPath);
validator.validateConfig(config);

const rootName = config.root_name || DEFAULTS.ROOT_NAME;
const universeDir = path.join(vDir, rootName);
if (!fs.existsSync(universeDir)) fs.mkdirSync(universeDir, { recursive: true });

const logFile = path.join(vDir, 'log.md');
const stateFile = path.join(vDir, 'state.json');
const memoryFile = path.join(vDir, 'collective_memory.md');

let state = stateManager.loadState(stateFile);

if (!state) {
    state = {
        round: 1,
        agents: config.agents.map(a => ({
            id: a.id,
            system_prompt: a.system_prompt,
            alive: true,
            deathRound: config.death_logic?.enabled ? (
                Math.random() < config.death_logic.early_death_chance 
                ? Math.floor(Math.random() * (config.death_logic.end_range[0] - 1)) + 1 
                : Math.floor(Math.random() * (config.death_logic.end_range[1] - config.death_logic.end_range[0] + 1)) + config.death_logic.end_range[0]
            ) : null,
            needsResumeNotify: false,
            needsEpochNotify: false
        })),
        globalHistory: [],
        turnSequence: [],
        currentTurnIndex: 0,
        totalTurns: 0,
        isResumed: false
    };
    const initialMsg = config.agents.find(a => a.initial_trigger)?.initial_trigger || "Erwacht.";
    state.totalTurns = 1;
    state.globalHistory.push({ agent: 'System', text: `${TAGS.UR_IMPULS}: ${initialMsg}` });
} else {
    state.isResumed = true;
    state.agents.forEach(a => a.needsResumeNotify = true);
}

// API Setup
const envPath = path.join(projectRoot, '.env');
let apiKey = process.env.GEMINI_API_KEY;
if (!apiKey && fs.existsSync(envPath)) {
    const match = fs.readFileSync(envPath, 'utf8').match(/GEMINI_API_KEY=(.*)/);
    if (match) apiKey = match[1].trim();
}
const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${config.model}:generateContent?key=${apiKey}`;

async function run() {
    const distillationInterval = config.distillation_interval || DEFAULTS.DISTILLATION_INTERVAL;
    config.max_turns = state.agents.length * distillationInterval * 2;
    
    console.log(`Starte ${version} (${state.agents.length} Agenten) in [${rootName}]...`);
    if (!fs.existsSync(logFile)) logger.writeLogHeader(logFile, version, config, state.agents, rootName);

    const maxRounds = config.endless_mode ? 500 : config.rounds;
    let simActive = true;
    let errorOccurred = null;

    try {
        for (let r = state.round; r <= maxRounds && simActive; r++) {
            state.round = r;
            console.log(`Zyklus ${r}/${maxRounds}...`);

            const isIntervallEnd = (r > 1 && (r - 1) % distillationInterval === 0 && state.currentTurnIndex === 0);
            if (isIntervallEnd || state.globalHistory.length >= config.max_turns && state.currentTurnIndex === 0) {
                const success = await stateManager.runDistillation(apiUrl, state.globalHistory, memoryFile);
                if (success) {
                    fs.appendFileSync(logFile, `\n### ${TAGS.MEMORY}: Destillation in Zyklus ${r} abgeschlossen.\n\n`);
                    state.globalHistory = state.globalHistory.slice(-state.agents.filter(a => a.alive).length);
                    state.agents.forEach(a => a.needsEpochNotify = true);
                    stateManager.saveState(stateFile, state);
                }
            }

            if (state.currentTurnIndex === 0) {
                state.turnSequence = state.agents.filter(a => a.alive).sort(() => Math.random() - 0.5).map(a => a.id);
            }

            while (state.currentTurnIndex < state.turnSequence.length && simActive) {
                const agent = state.agents.find(a => a.id === state.turnSequence[state.currentTurnIndex]);
                if (!agent || !agent.alive) { state.currentTurnIndex++; continue; }

                if (agent.deathRound && r > agent.deathRound) {
                    agent.alive = false;
                    const dMsg = `${TAGS.LOSS}: ${agent.id} ist erloschen.`;
                    fs.appendFileSync(logFile, `### Zyklus ${r} - System\n> ${dMsg}\n\n`);
                    state.globalHistory.push({ agent: 'System', text: dMsg });
                    state.currentTurnIndex++;
                    stateManager.saveState(stateFile, state);
                    continue;
                }

                console.log(`  Zug: ${agent.id}`);
                const envState = envManager.getEnvState(universeDir);
                const memory = fs.existsSync(memoryFile) ? fs.readFileSync(memoryFile, 'utf8') : "";
                
                const dynamicBasePrompt = (config.global_system_instruction || "").replace(/\[ROOT\]/g, rootName);
                const dynamicAgentPrompt = (agent.system_prompt || "").replace(/\[ROOT\]/g, rootName);
                const payload = apiClient.buildAgentContext(agent.id, state.globalHistory, memory, envState, dynamicBasePrompt, dynamicAgentPrompt, config.anonymity);

                try {
                    let reply = await apiClient.callGemini(apiUrl, payload);
                    // Reinigung basierend auf zentralen TAGS
                    Object.values(TAGS).forEach(tag => {
                        const regex = new RegExp(`^(\\*\\*?)?\\${tag}(\\*\\*?)?:\\s*`, 'gmi');
                        reply = reply.replace(regex, "");
                    });
                    
                    const feedback = envManager.processActions(reply, universeDir);
                    
                    state.totalTurns++;
                    state.globalHistory.push({ agent: agent.id, text: reply, feedback: feedback });
                    logger.appendTurnLog(logFile, r, agent.id, state.totalTurns, state.globalHistory.length, reply, feedback, rootName, state.isResumed);
                    
                    state.isResumed = false;
                    if (reply.includes(SYNTAX.FINISH)) simActive = false;
                    
                    state.currentTurnIndex++;
                    stateManager.saveState(stateFile, state);
                    await new Promise(res => setTimeout(res, 500));
                } catch (err) { 
                    console.error(`Fehler bei ${agent.id}:`, err.message); 
                    errorOccurred = err;
                    simActive = false;
                }
            }
            if (simActive && state.agents.every(a => !a.alive)) simActive = false;
            if (simActive) state.currentTurnIndex = 0;
        }
    } catch (globalErr) {
        console.error("Framework-Fehler:", globalErr.message);
        errorOccurred = globalErr;
    } finally {
        await stateManager.finalizeSimulation(apiUrl, state, memoryFile, logFile, errorOccurred);
        console.log("Framework beendet.");
    }
}

run().catch(console.error);

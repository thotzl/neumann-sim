{
  "label": "DeepInfra",
  "endpoint": "https://api.deepinfra.com/v1/openai/chat/completions",
  "endpoint_config_key": "deepinfra_endpoint",
  "model": "Qwen/Qwen2.5-Coder-32B-Instruct",
  "api_key_env": ["DEEP_INFRA_KEY", "DEEPINFRA_API_KEY", "API_KEY"],
  "body_defaults": { "temperature": 0.2 },
  "max_tokens": { "default": 4096 },
  "throttle_ms": 0,
  "retry_delay_ms": 4000,
  "rate_limit": { "delay_ms": 12000, "patterns": ["rate limit", "limit", "quota", "exceeded"] }
}
